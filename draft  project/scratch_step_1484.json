 End Single Fact Counter Style1 -->\n                </div>\n            </div>\n        </section>\n        <!-- End Fact Counter Style1 -->'''\n\nc = re.sub(r'<!--\\s*Start Fact Counter Style1\\s*-->.*?<!--\\s*End Fact Counter Style1\\s*-->', fact_counter_new, c, flags=re.DOTALL)\n\n# -----------------------------------------------------------------------------\n# STEP 5: COMMENT OUT OLD HOME 1 PRODUCTS SECTION (Products Style1)\n# -----------------------------------------------------------------------------\ndef comment_out_products(match):\n    block = match.group(0)\n    return f\"<!-- INACTIVE OLD HOMEPAGE PRODUCTS SECTION COMMENTED OUT FOR INDOVEL EXPORT CATALOGUE -->\\n<!--\\n{block}\\n-->\"\n\nc = re.sub(r'<!--\\s*Start Products Style1\\s*-->.*?<!--\\s*End Products Style1\\s*-->', comment_out_products, c, flags=re.DOTALL)\n\n# -----------------------------------------------------------------------------\n# STEP 3: \"STEP INTO OUR WORLD\" SECTION (Activities Style1)\n# -----------------------------------------------------------------------------\nactivities_new = '''<!-- Start Activities Style1 -->\n        <section class=\"activities-style1\" style=\"padding: 90px 0; background: #ffffff;\">\n            <div class=\"container\">\n                <div class=\"row align-items-center\">\n                    <div class=\"col-xl-6 col-lg-6\">\n                        <div class=\"activities-style1__content\">\n                            <div class=\"section-title text-left\">\n                                <div class=\"sub-title\">\n                                    <div class=\"icon\">\n                                        <i class=\"icon-hat\"></i>\n                                    </div>\n                                    <h4>Step Into Our World</h4>\n                                </div>\n                                <h2 class=\"title-animation\">From Indian Sources to Global Markets</h2>\n                            </div>\n                