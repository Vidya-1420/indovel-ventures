yle1__text\" style=\"margin-bottom: 25px;\">\n                                <p>Indovel Ventures is committed to responsible sourcing, rigorous quality checks, and transparent supply chain coordination for all international export orders.</p>\n                            </div>\n                            <div class=\"dodont-style1__list\">\n                                <ul class=\"list-unstyled\">\n                                    <li style=\"margin-bottom: 15px; display: flex; align-items: flex-start; gap: 12px;\">\n                                        <i class=\"icon-check\" style=\"color: var(--thm-primary-color, #f4a261); font-size: 18px; margin-top: 4px;\"></i>\n                                        <div>\n                                            <h5 style=\"font-size: 17px; font-weight: 700; color: #33271e; margin-bottom: 4px;\">Verified Farming & Supplier Hubs</h5>\n                                            <p style=\"font-size: 14px; color: #666; margin: 0;\">We source directly from established regional agricultural hubs across India.</p>\n                                        </div>\n                                    </li>\n                                    <li style=\"margin-bottom: 15px; display: flex; align-items: flex-start; gap: 12px;\">\n                                        <i class=\"icon-check\" style=\"color: var(--thm-primary-color, #f4a261); font-size: 18px; margin-top: 4px;\"></i>\n                                        <div>\n                                            <h5 style=\"font-size: 17px; font-weight: 700; color: #33271e; margin-bottom: 4px;\">Export Quality Standards</h5>\n                                            <p style=\"font-size: 14px; color: #666; margin: 0;\">Every batch is evaluated against destination specifications and buyer requirements.</p>\n                                        </div>\n                                    </li>\n                                    <li style=\"margin-bottom: 15px; display: flex; align-items: flex-start; gap: 12px;\">\n                                        <i class=\"icon-check\" style=\"color: var(--thm-primary-color, #f4a261); font-size: 18px; margin-top: 4px;\"></i>\n                                        <div>\n                                            <h5 style=\"font-size: 17px; font-weight: 700; color: #33271e; margin-bottom: 4px;\">Transparent & Timely Execution</h5>\n                                            <p style=\"font-size: 14px; color: #666; margin: 0;\">Clear communication on schedules, packaging options, and logistics support.</p>\n                                        </div>\n                                    </li>\n                                </ul>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"col-xl-6 col-lg-6\">\n                        <div class=\"dodont-style1__image-box\" style=\"text-align: center;\">\n                            <div style=\"border-radius: 15px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.08);\">\n                                <img src=\"assets/images/about/about-v1-1.jpg\" alt=\"Responsible Sourcing and Quality\" style=\"width: 100%; max-height: 420px; object-fit: cover;\">\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- End Responsible Sourcing & Quality Section -->'''\n\nc = re.sub(r'<!--\\s*Start Do Dont Style1\\s*-->.*?<!--\\s*End Do Dont Style1\\s*-->', dodont_section_new, c, flags=re.DOTALL)\n\n# -----------------------------------------------------------------------------\n# STEP 9: FAQ SECTION CLEANUP (Faq Style1)\n# -----------------------------------------------------------------------------\nfaq_section_new = '''<!-- Start Faq Style1 -->\n        <section class=\"faq-style1\" style=\"padding: 90px 0; background: #faf6f0;\">\n            <div class=\"container\">\n                <div class=\"section-title text-center\" style=\"margin-bottom: 45px;\">\n                    <div class=\"sub-title\" style=\"justify-content: center;\">\n                        <div class=\"icon\">\n                            <i class=\"icon-hat\"></i>\n                        </div>\n                        <h4>Frequently Asked Questions</h4>\n                    </div>\n                    <h2 class=\"title-animation\">Export & Sourcing Enquiries</h2>\n                </div>\n                <div class=\"row\">\n                    <div class=\"col-xl-12\">\n                        <div class=\"accrodion-grp faq-one-accrodion\" data-grp-name=\"faq-one-accrodion\">\n                            \n                            <!-- FAQ Item 1 -->\n                            <div class=\"accrodion active\">\n                                <div class=\"accrodion-title\">\n                                    <h4>What products does Indovel Ventures export?</h4>\n                                </div>\n                                <div class=\"accrodion-content\">\n                                    <div class=\"inner\">\n                                        <p>Indovel Ventures exports a wide range of premium Indian agricultural commodities including Spices, Coffee, Pulses & Grains, Fresh Fruits, Vegetables, and Dehydrated Fruits & Vegetables.</p>\n                                    </div>\n                                </div>\n                            </div>\n\n                            <!-- FAQ Item 2 -->\n                            <div class=\"accrodion\">\n                                <div class=\"accrodion-title\">\n                                    <h4>Which markets do you serve?</h4>\n                                </div>\n                                <div class=\"accrodion-content\">\n                                    <div class=\"inner\">\n                                        <p>We serve international commercial buyers, importers, food processors, and distributors across global markets in Europe, Middle East, Asia, and the Americas.</p>\n                                    </div>\n                                </div>\n                            </div>\n\n                            <!-- FAQ Item 3 -->\n                            <div class=\"accrodion\">\n                                <div class=\"accrodion-title\">\n                                    <h4>Can buyers request specific packaging options?</h4>\n                                </div>\n                                <div class=\"accrodion-content\">\n                                    <div class=\"inner\">\n                                        <p>Yes, we coordinate customized bulk and retail packaging based on product type, shipping mode, and destination regulatory requirements.</p>\n                                    </div>\n                                </div>\n                            </div>\n\n                            <!-- FAQ Item 4 -->\n                            <div class=\"accrodion\">\n                                <div class=\"accrodion-title\">\n                                    <h4>How can I send an export enquiry?</h4>\n                                </div>\n                                <div class=\"accrodion-content\">\n                                    <div class=\"inner\">\n                                        <p>You can submit an enquiry through our Contact page form or email us at info@indovelventures.com with your required product, quantity, destination port, and delivery timeline.</p>\n                                    </div>\n                                </div>\n                            </div>\n\n                            <!-- FAQ Item 5 -->\n                            <div class=\"accrodion\">\n                                <div class=\"accrodion-title\">\n                                    <h4>Do you support commercial bulk orders?</h4>\n                                </div>\n                                <div class=\"accrodion-content\">\n                                    <div class=\"inner\">\n                                        <p>Yes, we specialize in commercial bulk supply and export-ready container shipments.</p>\n                                    </div>\n                                </div>\n                            </div>\n\n                            <!-- FAQ Item 6 -->\n                            <div class=\"accrodion\">\n                                <div class=\"accrodion-title\">\n                                    <h4>Can product specifications be discussed before order confirmation?</h4>\n                                </div>\n                                <div class=\"accrodion-content\">\n                                    <div class=\"inner\">\n                                        <p>Absolutely. Our team coordinates directly with buyers to discuss product grades, specifications, packaging, and logistics prior to order confirmation.</p>\n                                    </div>\n                                </div>\n                            </div>\n\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- End Faq Style1 -->'''\n\nc = re.sub(r'<!--\\s*Start Faq Style1\\s*-->.*?<!--\\s*End Faq Style1\\s*-->', faq_section_new, c, flags=re.DOTALL)\n\nwith open(fpath, 'w', encoding='utf-8') as f:\n    f.write(c)\n\nprint(\"SUCCESS: Applied full Home 1 content cleanup and section updates to index.html!\")\n","Description":"Apply full Home 1 content cleanup and section updates to index.html","Overwrite":true,"TargetFile":"C:\\Users\\User\\.gemini\\antigravity\\brain\\7d1dd20d-1aa2-417a-80fb-4dd5af4866b5\\scratch\\apply_full_home1_update.py","toolAction":"Creating apply_full_home1_update.py","toolSummary":"Create apply_full_home1_update.py"}}]}
